# server.env — 服务器环境变量（pm2 env_file 加载，见 ecosystem.config.cjs）
#
# 部署步骤:
#   cp server.env.example server.env   # 本文件进 .gitignore，服务器本地维护
#   编辑 server.env 填真实口令后:  pm2 start ecosystem.config.cjs
#
# 发布新版本时 git pull 不会覆盖 server.env，无需再改 ecosystem.config.cjs。
# 修改本文件后需要重启进程生效（env_file 只在启动时读取）:
#   pm2 restart mxd-server --update-env && pm2 restart waigua-info && pm2 restart account-info

# shenmi 暗号:页面解锁 + /api/ocr*、/api/price 校验（server.js 默认 zhuzhu）
SHENMI_CODE=xiaozhu

# 经验上报 v2（/api/v2/exp/*）：
#   EXP_JWT_SECRET    —— JWT HS256 签名密钥，只留在服务端，务必改强随机串
#   EXP_DEVICE_SECRET —— PC 工具内置的设备密钥，POST /api/v2/exp/token 换 JWT 用
#   两者缺省为开发值（server.js 会警告）；生产不设置 v2 鉴权等于形同虚设
EXP_JWT_SECRET=CHANGE_ME_RANDOM
EXP_DEVICE_SECRET=CHANGE_ME_RANDOM

# MySQL 连接（schema.sql 建库后使用；本地开发不用本文件，走 db.js 开发默认值）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mxd
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=mxd_helper
